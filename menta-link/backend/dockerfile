# Usamos una imagen oficial de Python optimizada para producción
FROM python:3.11-slim

# Creamos el directorio de trabajo dentro del contenedor
WORKDIR /code

# Copiamos el archivo de requerimientos
COPY ./requirements.txt /code/requirements.txt

# Instalamos las dependencias (en Hugging Face correrá rápido gracias a los 16GB de RAM)
RUN pip install --no-cache-dir --upgrade -r /code/requirements.txt

# Copiamos todo el código de tu carpeta backend al contenedor
COPY . /code

# Le decimos a Hugging Face que exponga el puerto 7860 (obligatorio para la plataforma)
CMD ["uvicorn", "app.main:app", "--host", "0.0.0.0", "--port", "7860"]